// Test profile used in CI for stub smoke tests.
// Stub databases are created at CI time in tests/stub_dbs/ (not committed).

params {
    genome_manifest    = "${projectDir}/tests/data/test_manifest.tsv"
    priority_tsv       = "${projectDir}/tests/data/test_priority.tsv"
    gunc_db            = "${projectDir}/tests/stub_dbs/gunc.db"
    checkm2_db         = "${projectDir}/tests/stub_dbs/checkm2.db"
    bakta_db           = "${projectDir}/tests/stub_dbs/bakta_db"
    kofamscan_profiles = "${projectDir}/tests/stub_dbs/kofamscan_profiles.tar.gz"
    kofamscan_ko_list  = "${projectDir}/tests/stub_dbs/ko_list.gz"
    eggnogmapper_db    = "${projectDir}/tests/stub_dbs/eggnogmapper_db"
    outdir             = "${projectDir}/tests/results"
}

process {
    conda     = null
    container = null
    executor  = 'local'
    cpus      = 1
    memory    = '1 GB'
    time      = '10 m'
}

conda.enabled      = false
docker.enabled     = false
singularity.enabled = false
apptainer.enabled  = false

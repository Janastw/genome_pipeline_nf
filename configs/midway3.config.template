// Copy this file to midway3.config and fill in your values.
// midway3.config is gitignored — do not commit it directly.

process {
    cache          = 'lenient'
    executor       = 'slurm'
    clusterOptions = "--output=job-info.output --error=job-info.err --account=YOUR_SLURM_ACCOUNT --partition=YOUR_PARTITION"
}

env {
    APPTAINERENV_TMPDIR   = "$PWD"
    SINGULARITYENV_TMPDIR = "$PWD"
    APPTAINERENV_TMP      = "$PWD"
    SINGULARITYENV_TMP    = "$PWD"
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = "--bind /scratch/midway3/YOUR_CNETID:/tmp --bind /path/to/gunc/database"
    cacheDir   = "/path/to/singularity/cacheDir"
}
